{
  "name": "dsh-workspace-scratch",
  "version": "0.2.3",
  "description": "Keep a DeepSeek Harness workspace clean: every session gets a hidden .dsh directory for its scratch files and durable memory notes, plus scratch/memory tools, prompt guidance and a Settings page.",
  "type": "module",
  "icon": "./icon.svg",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "settings.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "plugin-index.json",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.2.0-0 <1.0.0-0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "build:index": "node scripts/build-index.mjs",
    "prepublishOnly": "npm run build:index && npm test"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "workspace",
    "scratch",
    "memory"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "^0.2.1-alpha.4"
  },
  "author": "qhdhiman",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qhdhiman/dsh-workspace-scratch.git"
  },
  "homepage": "https://github.com/qhdhiman/dsh-workspace-scratch#readme",
  "bugs": {
    "url": "https://github.com/qhdhiman/dsh-workspace-scratch/issues"
  }
}
